*.cs text
*.unity text
*.prefab text
*.asset text
*.meta text
*.json text
*.md text
*.yaml text
*.yml text
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.onnx binary
*.fbx binary
*.pdf binary
